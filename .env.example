# Spotify Wrapped backend — see BACKEND_SETUP.md for full setup instructions.
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Client ID from your Spotify Developer Dashboard app.
SPOTIFY_CLIENT_ID=

# Client Secret from your Spotify Developer Dashboard app. Keep this private —
# it is only ever used server-side (token exchange / refresh).
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on your Spotify Developer
# Dashboard app (Settings > Redirect URIs). For local development this is
# typically:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
